generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Assignor {
  id        String    @id
  document  String
  email     String
  phone     String
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  payables  Payable[]
  
  @@map("assignors")
}

model Payable {
  id           String    @id
  value        Float
  emissionDate DateTime
  assignorId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  assignor     Assignor  @relation(fields: [assignorId], references: [id])
  
  @@map("payables")
}

model User {
  id        String    @id
  login     String    @unique
  password  String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("users")
}
